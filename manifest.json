{
  "manifest_version": 3,
  "name": "XNote Extension",
  "key": "",
  "version": "1.0.0",
  "description": "AI-powered note-taking and productivity extension",
  "permissions": [
    "identity",
    "sidePanel",
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "clipboardRead",
    "alarms"
  ],
  "oauth2": {
    "client_id": "1014810627971-oou6s3jbjobvl2oedj22bl4q6a1iio7t.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.readonly",
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Open XNote Sidebar"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+G",
        "mac": "Command+G"
      },
      "description": "Open XNote Sidebar"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
